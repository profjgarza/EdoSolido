Notebook[{

Cell[CellGroupData[{
Cell["\<\
Procedimiento para generar los vectores unitarios a partir de datos de la \
celda unitaria\
\>", "Title",
 CellChangeTimes->{{3.9522058164907703`*^9, 3.952205826341219*^9}, {
  3.952209937946375*^9, 
  3.952209989053945*^9}},ExpressionUUID->"add8a3b7-683c-4a5b-818b-\
27996311cd58"],

Cell[CellGroupData[{

Cell["Jorge Garza . Marzo de 2024", "Section",
 CellChangeTimes->{{3.952209965748621*^9, 
  3.952209997368433*^9}},ExpressionUUID->"1f2cbd23-8625-4bb5-9c2c-\
1f24bf024068"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Datos", " ", "de", " ", "la", " ", "celda", " ", "unitaria"}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"a", "=", "2."}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"b", "=", "2.5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"c", "=", "3."}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"alfa", "=", 
     RowBox[{"Pi", "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"beta", "=", 
     RowBox[{"Pi", "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gama", "=", 
     RowBox[{"Pi", "/", "3"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Generaci\[OAcute]n", " ", "de", " ", "los", " ", "vectores", " ", 
     "unitarios"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vectora", "=", 
     RowBox[{"a", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0", ",", "0"}], "}"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vectorb", "=", 
     RowBox[{"b", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Cos", "[", "gama", "]"}], ",", 
        RowBox[{"Sin", "[", "gama", "]"}], ",", "0"}], "}"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vectorc", "=", 
     RowBox[{"c", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Cos", "[", "beta", "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Cos", "[", "alfa", "]"}], 
          RowBox[{"Csc", "[", "gama", "]"}]}], "-", 
         RowBox[{
          RowBox[{"Cot", "[", "gama", "]"}], " ", 
          RowBox[{"Cos", "[", "beta", "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"Csc", "[", "gama", "]"}], " ", 
         RowBox[{"Sqrt", "[", " ", 
          RowBox[{"1", "\[Minus]", 
           RowBox[{
            RowBox[{"Cos", "[", "alfa", "]"}], "^", "2"}], "\[Minus]", 
           RowBox[{
            RowBox[{"Cos", "[", "beta", "]"}], "^", "2"}], "\[Minus]", 
           RowBox[{
            RowBox[{"Cos", "[", "gama", "]"}], "^", "2"}], "+", 
           RowBox[{"2", " ", 
            RowBox[{"Cos", "[", "alfa", "]"}], " ", 
            RowBox[{"Cos", "[", "beta", "]"}], " ", 
            RowBox[{"Cos", "[", "gama", "]"}]}]}], "]"}]}]}], "}"}]}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vol", "=", 
     RowBox[{"vectorc", ".", 
      RowBox[{"Cross", "[", 
       RowBox[{"vectora", ",", "vectorb"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Generando", " ", "los", " ", "v\[EAcute]rtices", " ", "de", " ", "la", 
     " ", "celda"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vectores", "=", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Arrow", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", "vectora"}], "}"}],
          "]"}], ",", 
        RowBox[{"Arrow", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", "vectorb"}], "}"}],
          "]"}], ",", 
        RowBox[{"Arrow", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", "vectorc"}], "}"}],
          "]"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Generando", " ", "el", " ", "volumen", " ", "que", " ", "envuelve", " ", 
     "a", " ", "los", " ", "v\[EAcute]rtices"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"volumen", "=", 
     RowBox[{"ConvexHullMesh", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", "vectora", ",", 
        "vectorb", ",", "vectorc", ",", 
        RowBox[{"vectora", "+", "vectorb"}], ",", 
        RowBox[{"vectora", "+", "vectorc"}], ",", 
        RowBox[{"vectorb", "+", "vectorc"}], ",", 
        RowBox[{"vectora", "+", "vectorb", "+", "vectorc"}]}], "}"}], "]"}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{"vectores", ",", "volumen"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9522058303358593`*^9, 3.952205924778349*^9}, {
  3.952206469296999*^9, 3.952206617170795*^9}, {3.9522066547526217`*^9, 
  3.952206887952896*^9}, {3.952206964262376*^9, 3.952206971797216*^9}, {
  3.9522073431380663`*^9, 3.9522073444082737`*^9}, {3.952207445095521*^9, 
  3.9522074456124773`*^9}, {3.9522077491927347`*^9, 3.952207751811562*^9}, {
  3.952209932616887*^9, 3.952209933098776*^9}, {3.952210001431028*^9, 
  3.9522100812848997`*^9}, {3.952210128512672*^9, 3.952210149057605*^9}, {
  3.952255030011547*^9, 3.952255034105727*^9}, {3.952257647829218*^9, 
  3.952257650629743*^9}, {3.957876208432702*^9, 3.957876212961136*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"9336d5b3-b1b0-4b9a-a6f7-6bc4d1303646"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Transformaci\[OAcute]n de coordenadas relativas a coordenadas cartesianas\
\>", "Section",
 CellChangeTimes->{{3.95225501058629*^9, 3.952255025241276*^9}, 
   3.9522550609979153`*^9},ExpressionUUID->"b0f17102-bc38-4415-aae0-\
93b677a755b6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"matoriginal", "=", 
   RowBox[{"{", 
    RowBox[{"vectora", ",", "vectorb", ",", "vectorc"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"transformacion1", "=", 
   RowBox[{"Transpose", "[", "matoriginal", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"transformacion2", "=", 
   RowBox[{"Inverse", "[", "transformacion1", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.952255315704632*^9, 3.9522553751594477`*^9}, {
  3.9522568128015823`*^9, 3.95225683967834*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"9b60a072-7310-42e3-a27a-f370fb2b3ce8"],

Cell[BoxData[
 RowBox[{"matoriginal", "//", "MatrixForm"}]], "Input",
 CellChangeTimes->{{3.957875926805872*^9, 3.9578759397900763`*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"fdc3789f-65ab-4d5a-b0e2-fb467c7e3d83"],

Cell[BoxData[
 RowBox[{"MatrixForm", "[", "transformacion1", "]"}]], "Input",
 CellChangeTimes->{{3.9522570764436207`*^9, 3.952257081156692*^9}},
 CellLabel->"In[19]:=",ExpressionUUID->"a3f3ccf5-eae2-4c80-9006-0886c1959b12"],

Cell[BoxData[
 RowBox[{"MatrixForm", "[", "transformacion2", "]"}]], "Input",
 CellChangeTimes->{{3.952257104500794*^9, 3.95225711353375*^9}},
 CellLabel->"In[20]:=",ExpressionUUID->"4efa717e-96d9-46d8-ba4f-4973c12c9766"],

Cell[BoxData[
 RowBox[{"MatrixForm", "[", 
  RowBox[{"transformacion1", ".", "transformacion2"}], "]"}]], "Input",
 CellChangeTimes->{{3.952256847192214*^9, 3.952256885385173*^9}, {
  3.952257758111927*^9, 3.952257815643051*^9}},
 CellLabel->"In[21]:=",ExpressionUUID->"0f0c58e6-cca9-4e63-938f-7992473e2374"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "vector", " ", "definido", " ", "en", " ", "coordenadas", " ", 
    "relativas"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"vectuno", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "/", "2"}], ",", 
       RowBox[{"1", "/", "2"}], ",", 
       RowBox[{"1", "/", "2"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vectinteres", "=", 
     RowBox[{"Transpose", "[", "vectuno", "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.957876342894293*^9, 3.957876389178446*^9}, {
  3.957998772814146*^9, 3.9579987898527107`*^9}},
 CellLabel->"In[22]:=",ExpressionUUID->"4aa5e800-a8d9-4563-b6ce-4e5627d1a196"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "matriz", " ", "de", " ", "transformaci\[OAcute]n", " ", "sobre", " ", 
    "el", " ", "vector", " ", "previo"}], " ", "*)"}], "\[IndentingNewLine]", 
  
  RowBox[{
   RowBox[{"vectresultado", "=", 
    RowBox[{"transformacion1", ".", "vectinteres"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.957876751747273*^9, 3.957876767970643*^9}, 
   3.9578772815655823`*^9, {3.957998795737047*^9, 3.95799882137542*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"ec19875c-942a-4384-990e-4f777b38039a"],

Cell[BoxData[
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Es resultado es el vector:\>\"", ",", "vectresultado"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.957877349265605*^9, 3.957877383462901*^9}},
 CellLabel->"In[25]:=",ExpressionUUID->"78734ecc-c33d-4bf1-a0b5-44525edf09f7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"punto", "=", 
   RowBox[{"Graphics3D", "[", 
    RowBox[{"{", 
     RowBox[{"Blue", ",", 
      RowBox[{"Sphere", "[", 
       RowBox[{
        RowBox[{"{", "vectresultado", "}"}], ",", "0.2"}], "]"}]}], "}"}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.957876699901696*^9, 3.9578767425488157`*^9}, {
