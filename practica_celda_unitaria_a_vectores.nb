 CellLabel->"In[31]:=",ExpressionUUID->"0f7ba581-5c19-4373-82c3-7488075532ab"],

Cell[BoxData[
 RowBox[{"final", "=", 
  RowBox[{"Show", "[", 
   RowBox[{
    RowBox[{"HighlightMesh", "[", 
     RowBox[{"volumen", ",", 
      RowBox[{"Style", "[", 
       RowBox[{"2", ",", 
        RowBox[{"Opacity", "[", "0.2", "]"}]}], "]"}]}], "]"}], ",", "punto", 
    ",", "vectores"}], "]"}]}]], "Input",
