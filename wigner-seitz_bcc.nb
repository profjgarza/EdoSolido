Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"vectu", "[", 
    RowBox[{"n1_", ",", "n2_", ",", "n3_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"n1", "*", 
     RowBox[{"a", "[", "1", "]"}]}], "+", 
    RowBox[{"n2", "*", 
     RowBox[{"a", "[", "2", "]"}]}], "+", 
    RowBox[{"n3", "*", 
     RowBox[{"a", "[", "3", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"diferencia", "[", 
    RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
