    RowBox[{"vector", "[", "i", "]"}], "-", 
    RowBox[{"vector", "[", "j", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"medios", "[", 
    RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"puntos", "[", 
       RowBox[{"[", "i", "]"}], "]"}], "+", 
      RowBox[{"puntos", "[", 
       RowBox[{"[", "j", "]"}], "]"}]}], ")"}], "/", "2"}]}], ";"}]}], "Input",\

